# VisionWare RTMP Server Configuration

# Server Configuration
NODE_ENV=development
HTTP_PORT=8080
RTMP_PORT=1935

# Backend Services
BACKEND_URL=http://localhost:8000
MEDIASOUP_URL=http://localhost:3001

# Authentication
API_USER=admin
API_PASS=admin123

# Features
TRANSCRIPTION_ENABLED=true
MEDIASOUP_BRIDGE_ENABLED=true

# Media Storage
MEDIA_ROOT=./media

# Logging
LOG_LEVEL=info